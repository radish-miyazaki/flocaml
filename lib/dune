(library
 (name nix_syntax)
 (public_name nix-syntax)
 (libraries menhirLib sedlex)
 (modules_without_implementation ast)
 (private_modules lexer parser tokens)
 (preprocess
  (pps sedlex.ppx))
 ; Only active with --instrument-with bisect_ppx, so normal builds do not
 ; need bisect_ppx.
 (instrumentation
  (backend bisect_ppx)))

(menhir
 (modules tokens)
 (flags --only-tokens))

(menhir
 (modules tokens parser)
 (merge_into parser)
 (flags --external-tokens Tokens --table --strict))
